// Obsidian Commerce — multi-tenant persistence schema.
//
// Three rules hold throughout:
//
//  1. Tenancy. Every row that belongs to a merchant carries `storeId`, and every
//     uniqueness constraint is scoped by it — two tenants may both own the slug
//     "linen-shirt". Application queries go through a repository layer that
//     always supplies the tenant, and row-level security (see the RLS policy
//     notes in README) enforces it again in the database.
//
//  2. Money. Every monetary column is an integer in the currency's minor unit
//     (paise for INR). There is no Decimal and no Float anywhere in this file;
//     floating-point money is how a cart total ends up at ₹1,249.9999999.
//
//  3. Category independence. There is no `size`, `colour` or `ram` column. A
//     product's characteristics live in AttributeDefinition / ProductAttribute,
//     so a jewellery store and an electronics store use the same tables and the
//     same code path. Variant option values are rows, not columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* Tenancy and billing                                                 */
/* ------------------------------------------------------------------ */

enum StoreStatus {
  active
  trial
  paused
  suspended
  closed
}

enum Industry {
  fashion
  electronics
  beauty
  home
  furniture
  sports
  grocery
  jewelry
  books
  pets
  general
}

model Plan {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  tagline           String
  /// Minor units.
  monthlyPrice      Int
  annualPrice       Int
  currency          String  @default("INR")
  /// Basis points taken from merchant GMV, e.g. 150 = 1.50%.
  transactionFeeBps Int
  popular           Boolean @default(false)
  features          String[]

  maxProducts       Int
  maxStaff          Int
  maxMonthlyOrders  Int
  maxStorageGb      Int
  maxWarehouses     Int
  customDomain      Boolean @default(false)
  apiAccess         Boolean @default(false)
  advancedAnalytics Boolean @default(false)
  abandonedCart     Boolean @default(false)
  marketplace       Boolean @default(false)

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores        Store[]
  subscriptions Subscription[]

  @@index([position])
}

model Store {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  tagline      String
  description  String
  industry     Industry
  status       StoreStatus @default(trial)
  logoText     String
  logoMark     String

  currency String @default("INR")
  country  String @default("India")
  locale   String @default("en-IN")
  timezone String @default("Asia/Kolkata")

  /// Platform-issued subdomain; always present.
  domain       String  @unique
  /// Merchant-owned domain; verified separately.
  customDomain String? @unique

  supportEmail String
  supportPhone String

  /// Region the tenant's data is pinned to. Never changes after creation.
  region String @default("ap-south-1")

  ownerId String
  owner   User   @relation("StoreOwner", fields: [ownerId], references: [id])
  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])

  featureMarketplace    Boolean @default(false)
  featureLoyalty        Boolean @default(false)
  featureSubscriptions  Boolean @default(false)
  featureAiAssistant    Boolean @default(false)
  featureMultiWarehouse Boolean @default(false)
  featureB2b            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription  Subscription?
  members       StoreMember[]
  themes        Theme[]
  categories    Category[]
  brands        Brand[]
  collections   Collection[]
  attributes    AttributeDefinition[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  coupons       Coupon[]
  promotions    Promotion[]
  campaigns     Campaign[]
  giftCards     GiftCard[]
  warehouses    Warehouse[]
  inventory     InventoryRecord[]
  suppliers     Supplier[]
  reviews       Review[]
  tickets       SupportTicket[]
  pages         Page[]
  menus         NavigationMenu[]
  blogPosts     BlogPost[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  auditEntries  AuditLogEntry[]
  dailyMetrics  DailyMetric[]

  @@index([status])
  @@index([industry])
  @@index([planId])
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  paused
  cancelled
}

model Subscription {
  id       String             @id @default(cuid())
  storeId  String             @unique
  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan               @relation(fields: [planId], references: [id])
  status   SubscriptionStatus @default(trialing)
  /// "monthly" | "annual"
  interval String             @default("monthly")
  /// Minor units, for one whole interval.
  amount   Int
  currency String             @default("INR")
  seats    Int                @default(1)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  trialEndsAt      DateTime?
  cancelledAt      DateTime?

  invoices Invoice[]

  @@index([status])
  @@index([planId])
}

model Invoice {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String   @unique
  /// Minor units.
  subtotal       Int
  tax            Int
  total          Int
  currency       String   @default("INR")
  status         String   @default("open")
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime @default(now())
  paidAt         DateTime?

  @@index([subscriptionId, issuedAt])
}

/* ------------------------------------------------------------------ */
/* Identity and access                                                 */
/* ------------------------------------------------------------------ */

enum UserType {
  platform
  merchant
  staff
  customer
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  avatar       String?
  type         UserType @default(merchant)
  passwordHash String?
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedStores  Store[]       @relation("StoreOwner")
  memberships  StoreMember[]
  sessions     Session[]

  @@index([type])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for a platform operator session; set while impersonating a tenant.
  storeId   String?
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StoreMember {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   String
  /// Explicit permission keys, checked server-side on every write.
  permissions String[]
  status      String   @default("active")

  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([storeId, userId])
  @@index([storeId, role])
}

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  /// Displayable prefix; the secret itself is stored only as a hash.
  prefix     String
  secretHash String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([storeId, prefix])
  @@index([storeId])
}

model Webhook {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url          String
  topics       String[]
  status       String   @default("active")
  secretHash   String
  deliveries24h Int     @default(0)
  failures24h  Int      @default(0)
  createdAt    DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([storeId, status])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  topic        String
  payload      Json
  responseCode Int?
  error        String?
  attempts     Int      @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([webhookId, createdAt])
}

enum AuditSeverity {
  info
  warning
  critical
}

model AuditLogEntry {
  id         String        @id @default(cuid())
  /// Null for platform-scoped events.
  storeId    String?
  store      Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorId    String
  actorName  String
  actorType  String
  action     String
  resource   String
  resourceId String
  ip         String?
  userAgent  String?
  severity   AuditSeverity @default(info)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([storeId, createdAt])
  @@index([severity, createdAt])
  @@index([action])
}

/* ------------------------------------------------------------------ */
/* Catalogue — category-independent by construction                    */
/* ------------------------------------------------------------------ */

model Category {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")

  name        String
  slug        String
  description String?
  image       String?
  icon        String?
  industry    Industry
  level       Int     @default(0)
  position    Int     @default(0)
  featured    Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, parentId])
  @@index([storeId, featured])
}

model Brand {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  logo        String?
  cover       String?
  description String?
  origin      String?
  /// Verticals this brand actually sells into, so a jewellery house never
  /// ends up attached to a running shoe.
  industries  Industry[]
  featured    Boolean  @default(false)

  products Product[]

  createdAt DateTime @default(now())

  @@unique([storeId, slug])
  @@index([storeId, featured])
}

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  image       String?
  /// "manual" | "automatic"
  type        String   @default("manual")
  /// Rule set for automatic collections, e.g. tag = "sale" AND price < 200000.
  rules       Json?
  position    Int      @default(0)
  featured    Boolean  @default(false)

  products ProductCollection[]

  createdAt DateTime @default(now())

  @@unique([storeId, slug])
}

enum AttributeInputType {
  text
  longtext
  number
  boolean
  select
  multiselect
  color
  dimension
  date
}

/// The mechanism that makes this platform category-agnostic.
///
/// "Size", "RAM", "SPF" and "Carat" are all rows here, not columns anywhere.
/// `variantDefining` decides what participates in the variant matrix,
/// `filterable` decides what appears as a PLP facet, `displayInSpecs` decides
/// what appears in the PDP spec table. Adding a vertical means adding rows.
model AttributeDefinition {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  key       String
  label     String
  inputType AttributeInputType
  unit      String?
  /// Allowed values for select / multiselect, with labels and swatches.
  options   Json?

  variantDefining Boolean @default(false)
  filterable      Boolean @default(false)
  displayInSpecs  Boolean @default(true)
  searchable      Boolean @default(false)
  required        Boolean @default(false)

  /// Empty means "every category in this store".
  categoryIds String[]
  /// "all" or a specific vertical.
  industry    String   @default("all")
  position    Int      @default(0)

  values         ProductAttribute[]
  variantOptions VariantOption[]

  @@unique([storeId, key])
  @@index([storeId, filterable])
  @@index([storeId, variantDefining])
}

enum ProductStatus {
  draft
  active
  archived
  out_of_stock
}

enum ProductType {
  simple
  variable
  digital
  bundle
  subscription
  service
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String
  shortDescription String
  highlights       String[]

  productType ProductType   @default(simple)
  status      ProductStatus @default(draft)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  /// Ancestor ids, so a parent-category filter matches without a recursive CTE.
  categoryPath String[]
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])
  tags       String[]
  industry   Industry

  /// Minor units.
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  taxClassId     String @default("gst-18")

  sku     String
  barcode String?

  trackInventory   Boolean @default(true)
  allowBackorder   Boolean @default(false)
  totalStock       Int     @default(0)
  shippingRequired Boolean @default(true)

  weightGrams  Int?
  lengthMm     Int?
  widthMm      Int?
  heightMm     Int?

  digitalFileUrl           String?
  subscriptionIntervalDays Int?
  bundleProductIds         String[]

  /// Denormalised aggregates the storefront reads on every card.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)
  unitsSold     Int   @default(0)
  views         Int   @default(0)
  wishlistCount Int   @default(0)

  flagNew        Boolean @default(false)
  flagBestseller Boolean @default(false)
  flagFeatured   Boolean @default(false)
  flagLimited    Boolean @default(false)
  flagExclusive  Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media       ProductMedia[]
  attributes  ProductAttribute[]
  variants    ProductVariant[]
  collections ProductCollection[]
  reviews     Review[]
  questions   ProductQuestion[]
  orderItems  OrderItem[]

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status])
  @@index([storeId, categoryId])
  @@index([storeId, brandId])
  @@index([storeId, price])
  @@index([storeId, status, flagFeatured])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// "image" | "video"
  kind      String  @default("image")
  url       String
  alt       String
  width     Int?
  height    Int?
  position  Int     @default(0)

  @@index([productId, position])
}

/// One attribute value for one product. Typed columns rather than a single
/// stringly-typed blob, so numeric facets can use a range index.
model ProductAttribute {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  key          String

  valueText   String?
  valueNumber Float?
  valueBool   Boolean?
  valueList   String[]

  @@unique([productId, definitionId])
  @@index([key, valueText])
  @@index([key, valueNumber])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  barcode   String?
  title     String

  /// Minor units.
  price          Int
  compareAtPrice Int?
  costPrice      Int?

  weightGrams Int?
  image       String?
  position    Int     @default(0)
  status      String  @default("active")

  options   VariantOption[]
  inventory InventoryRecord[]
  orderItems OrderItem[]

  @@index([productId, position])
}

/// A variant's value for one variant-defining attribute — the row form of
/// "Colour: Black, Size: L". Adding "Carat" to jewellery needs no migration.
model VariantOption {
  id           String              @id @default(cuid())
  variantId    String
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  key          String
  value        String

  @@unique([variantId, definitionId])
  @@index([key, value])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

/* ------------------------------------------------------------------ */
/* Inventory                                                           */
/* ------------------------------------------------------------------ */

model Warehouse {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  code      String
  type      String  @default("warehouse")
  line1     String
  city      String
  state     String
  postalCode String
  country   String  @default("India")
  latitude  Float?
  longitude Float?
  priority  Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  inventory InventoryRecord[]
  transfersOut StockTransfer[] @relation("TransferSource")
  transfersIn  StockTransfer[] @relation("TransferDestination")
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, code])
  @@index([storeId, active])
}

model InventoryRecord {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  onHand      Int @default(0)
  /// Held by unfulfilled orders. Available = onHand - reserved.
  reserved    Int @default(0)
  incoming    Int @default(0)
  reorderPoint Int @default(0)
  reorderQty  Int @default(0)
  binLocation String?

  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([variantId, warehouseId])
  @@index([storeId, warehouseId])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  recordId    String
  record      InventoryRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// "sale" | "return" | "adjustment" | "transfer_in" | "transfer_out" | "receipt" | "damage"
  reason      String
  /// Signed: negative removes stock.
  quantity    Int
  balanceAfter Int
  reference   String?
  actor       String
  note        String?
  createdAt   DateTime @default(now())

  @@index([recordId, createdAt])
}

model Supplier {
  id           String  @id @default(cuid())
  storeId      String
  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  contactName  String
  email        String
  phone        String
  city         String
  country      String  @default("India")
  leadTimeDays Int     @default(7)
  paymentTerms String  @default("net_30")
  rating       Float   @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@index([storeId, active])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  storeId     String
  number      String
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String    @default("draft")
  /// Minor units.
  subtotal    Int
  tax         Int
  shipping    Int
  total       Int
  currency    String    @default("INR")
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  items PurchaseOrderItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  name            String
  sku             String
  quantity        Int
  receivedQty     Int @default(0)
  /// Minor units.
  unitCost        Int

  @@index([purchaseOrderId])
}

model StockTransfer {
  id            String    @id @default(cuid())
  storeId       String
  number        String
  fromId        String
  from          Warehouse @relation("TransferSource", fields: [fromId], references: [id])
  toId          String
  to            Warehouse @relation("TransferDestination", fields: [toId], references: [id])
  status        String    @default("draft")
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  createdAt     DateTime  @default(now())

  items StockTransferItem[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  name       String
  sku        String
  quantity   Int
  receivedQty Int @default(0)

  @@index([transferId])
}

/* ------------------------------------------------------------------ */
/* Customers                                                           */
/* ------------------------------------------------------------------ */

model Customer {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String
  phone     String
  avatar    String?
  /// "male" | "female" | "other" | "undisclosed"
  gender    String  @default("undisclosed")
  birthDate DateTime?

  status         String @default("active")
  tier           String @default("bronze")
  loyaltyPoints  Int    @default(0)
  /// Minor units.
  storeCredit    Int    @default(0)
  lifetimeValue  Int    @default(0)
  orderCount     Int    @default(0)
  averageOrderValue Int @default(0)

  acceptsMarketing Boolean @default(false)
  tags             String[]
  notes            String?

  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  questions ProductQuestion[]
  tickets   SupportTicket[]
  wishlist  WishlistItem[]

  @@unique([storeId, email])
  @@index([storeId, tier])
  @@index([storeId, createdAt])
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String  @default("home")
  firstName  String
  lastName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  @@unique([customerId, productId, variantId])
}

/* ------------------------------------------------------------------ */
/* Orders                                                              */
/* ------------------------------------------------------------------ */

enum OrderStatus {
  pending
  payment_pending
  payment_failed
  confirmed
  processing
  packed
  shipped
  out_for_delivery
  delivered
  cancelled
  return_requested
  return_approved
  returned
  refund_pending
  refunded
}

model Order {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber String
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String

  status           OrderStatus @default(pending)
  paymentStatus    String      @default("pending")
  fulfilmentStatus String      @default("unfulfilled")

  /// Every amount below is in minor units.
  subtotal        Int
  discountTotal   Int @default(0)
  shippingTotal   Int @default(0)
  taxTotal        Int @default(0)
  total           Int
  refundedTotal   Int @default(0)
  currency        String @default("INR")

  /// GST split: intra-state fills cgst+sgst, inter-state fills igst.
  cgst Int @default(0)
  sgst Int @default(0)
  igst Int @default(0)

  couponCode            String?
  loyaltyPointsEarned   Int @default(0)
  loyaltyPointsRedeemed Int @default(0)
  storeCreditUsed       Int @default(0)

  shippingMethodId String
  shippingMethod   String
  /// Addresses are snapshotted onto the order: a customer editing their
  /// address book must not retroactively change where a past order went.
  shippingAddress  Json
  billingAddress   Json

  giftMessage String?
  note        String?
  channel     String  @default("web")

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  items      OrderItem[]
  events     OrderEvent[]
  payments   Payment[]
  shipments  Shipment[]
  returns    ReturnRequest[]
  refunds    Refund[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, placedAt])
  @@index([storeId, customerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  /// Snapshotted so an invoice reprints identically after a rename or reprice.
  name         String
  variantTitle String
  sku          String
  image        String
  /// Minor units.
  unitPrice    Int
  quantity     Int
  discount     Int @default(0)
  tax          Int @default(0)
  total        Int
  taxRateBps   Int @default(1800)

  fulfilledQty Int @default(0)
  returnedQty  Int @default(0)

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  label     String
  note      String?
  actor     String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "upi" | "card" | "netbanking" | "wallet" | "cod" | "emi" | "gift_card"
  method        String
  status        String   @default("pending")
  /// Minor units.
  amount        Int
  currency      String   @default("INR")
  gateway       String   @default("razorpay")
  transactionId String?
  failureReason String?
  capturedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId    String
  carrier        String
  trackingNumber String
  trackingUrl    String?
  status         String    @default("label_created")
  weightGrams    Int?
  /// Minor units.
  cost           Int       @default(0)
  shippedAt      DateTime?
  estimatedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String
  note       String?
  occurredAt DateTime

  @@index([shipmentId, occurredAt])
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  status    String   @default("requested")
  reason    String
  comment   String?
  /// "refund" | "exchange" | "store_credit"
  resolution String  @default("refund")
  images    String[]
  pickupScheduledAt DateTime?
  receivedAt        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  ReturnItem[]
  refund Refund?

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id         String        @id @default(cuid())
  returnId   String
  return     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  quantity   Int
  reason     String

  @@index([returnId])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnId  String?  @unique
  return    ReturnRequest? @relation(fields: [returnId], references: [id])
  /// Minor units.
  amount    Int
  method    String
  status    String   @default("pending")
  reference String?
  note      String?
  createdAt DateTime @default(now())
  settledAt DateTime?

  @@index([orderId])
}

/* ------------------------------------------------------------------ */
/* Marketing                                                           */
/* ------------------------------------------------------------------ */

model Coupon {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code    String
  title   String
  description String?
  /// "percentage" | "fixed" | "free_shipping" | "bxgy"
  type    String
  /// Percent value in basis points, or a fixed amount in minor units.
  value   Int
  /// Minor units.
  minimumOrder Int  @default(0)
  maximumDiscount Int?

  usageLimit      Int?
  usageLimitPerCustomer Int @default(1)
  usageCount      Int  @default(0)
  appliesToProductIds  String[]
  appliesToCategoryIds String[]
  firstOrderOnly  Boolean @default(false)
  stackable       Boolean @default(false)
  active          Boolean @default(true)

  startsAt DateTime @default(now())
  endsAt   DateTime?
  createdAt DateTime @default(now())

  @@unique([storeId, code])
  @@index([storeId, active])
}

model Promotion {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String
  value       Int
  scope       Json
  priority    Int      @default(0)
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?

  @@index([storeId, active])
}

model Campaign {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  channel   String
  status    String   @default("draft")
  subject   String?
  audience  String
  recipients Int     @default(0)
  opened     Int     @default(0)
  clicked    Int     @default(0)
  converted  Int     @default(0)
  /// Minor units.
  revenue    Int     @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([storeId, status])
}

model GiftCard {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code       String
  /// Minor units.
  initialValue Int
  balance      Int
  currency   String   @default("INR")
  status     String   @default("active")
  recipientEmail String?
  message    String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([storeId, code])
  @@index([storeId, status])
}

/* ------------------------------------------------------------------ */
/* Engagement                                                          */
/* ------------------------------------------------------------------ */

model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  authorName String
  rating     Int
  title      String
  body       String
  images     String[]
  verified   Boolean  @default(false)
  helpful    Int      @default(0)
  status     String   @default("published")
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([storeId, productId])
  @@index([storeId, status])
  @@index([productId, rating])
}

model ProductQuestion {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  authorName String
  question   String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model SupportTicket {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number     String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?
  subject    String
  category   String
  priority   String   @default("normal")
  status     String   @default("open")
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages TicketMessage[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  /// "customer" | "agent" | "system"
  authorType String
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/* ------------------------------------------------------------------ */
/* Storefront content and theming                                      */
/* ------------------------------------------------------------------ */

/// A theme is data, not code. Publishing one rewrites a set of CSS custom
/// properties on the storefront wrapper; no component changes to restyle.
model Theme {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  preset      String
  description String?
  /// Palette, typography, shape and layout token groups.
  colors      Json
  typography  Json
  shape       Json
  layout      Json
  published   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, published])
}

model Page {
  id       String  @id @default(cuid())
  storeId  String
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title    String
  slug     String
  /// "home" | "landing" | "static" | "policy"
  kind     String  @default("static")
  status   String  @default("published")
  /// Ordered PageSection records — the homepage builder's output.
  sections Json
  body     String?
  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, kind])
}

model NavigationMenu {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  /// "header" | "footer" | "mobile"
  location String
  items    Json

  @@unique([storeId, location, name])
}

model BlogPost {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  excerpt     String
  body        String
  cover       String
  author      String
  tags        String[]
  readMinutes Int      @default(4)
  status      String   @default("published")
  publishedAt DateTime @default(now())

  @@unique([storeId, slug])
  @@index([storeId, publishedAt])
}

/* ------------------------------------------------------------------ */
/* Analytics                                                           */
/* ------------------------------------------------------------------ */

/// Pre-aggregated daily rollups. Dashboards read these, never the order table
/// — a merchant with two million orders should not scan them to draw a sparkline.
model DailyMetric {
  id       String   @id @default(cuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  /// Minor units.
  revenue  Int @default(0)
  orders   Int @default(0)
  units    Int @default(0)
  visitors Int @default(0)
  sessions Int @default(0)
  newCustomers Int @default(0)
  returningCustomers Int @default(0)
  refunds  Int @default(0)
  averageOrderValue Int @default(0)
  conversionRate    Float @default(0)

  @@unique([storeId, date])
  @@index([storeId, date])
}
